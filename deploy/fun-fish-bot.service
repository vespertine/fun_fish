[Unit]
Description=fun_fish : bot Lichess
After=network-online.target
Wants=network-online.target

[Service]
User=funfish
# La version en service : /srv/fun_fish/current, un lien posé par deploy/update.sh
WorkingDirectory=/srv/fun_fish/current
# Réglages du bot : éditer /etc/default/fun-fish-bot (FUN_FISH_BOT_ARGS="--max-games 2 -s luxury_cap=200")
EnvironmentFile=-/etc/default/fun-fish-bot
ExecStart=/bin/sh -c 'exec /srv/fun_fish/current/.venv/bin/fun-fish lichess-bot $FUN_FISH_BOT_ARGS'
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
# Durcissement : le bot n'écrit que dans son propre dossier
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/funfish
PrivateTmp=true

[Install]
WantedBy=multi-user.target
